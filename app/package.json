{
  "name": "desktop-pet",
  "version": "0.1.0",
  "description": "Desktop pet with Live2D + PNG sprites + LLM chat (Electron + Vite + React)",
  "main": "dist-electron/main.js",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "npm run build:live2d:all",
    "build:prepare": "tsc -p tsconfig.node.json && vite build",
    "build:personal": "npm run build:live2d:all",
    "build:public": "npm run build:live2d:none",
    "build:live2d:all": "npm run build:prepare && electron-builder --config electron-builder.live2d-all.yml",
    "build:live2d:common": "npm run build:prepare && electron-builder --config electron-builder.live2d-common.yml",
    "build:live2d:none": "npm run build:prepare && electron-builder --config electron-builder.live2d-none.yml",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.node.json --noEmit",
    "lint": "echo \"(no linter configured yet)\""
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@modelcontextprotocol/server-filesystem": "^2026.1.14",
    "@pixi/constants": "^7.4.3",
    "@pixi/core": "^7.4.3",
    "@pixi/display": "^7.4.3",
    "@pixi/events": "^7.4.3",
    "@pixi/extensions": "^7.4.3",
    "@pixi/math": "^7.4.3",
    "@pixi/runner": "^7.4.3",
    "@pixi/settings": "^7.4.3",
    "@pixi/ticker": "^7.4.3",
    "@pixi/utils": "^7.4.3",
    "electron-store": "^8.2.0",
    "get-windows": "^9.3.0",
    "katex": "^0.16.45",
    "mammoth": "^1.12.0",
    "mermaid": "^11.14.0",
    "pdf-parse": "^2.4.5",
    "pixi-live2d-display-lipsyncpatch": "^0.5.0-ls-8",
    "pixi.js": "^7.4.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.1",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "remark-github-blockquote-alert": "^2.1.0",
    "remark-math": "^6.0.0",
    "vosk-browser": "^0.0.8",
    "xlsx": "^0.18.5",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "@types/pdf-parse": "^1.1.5",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@vitejs/plugin-react": "^4.3.2",
    "electron": "^33.0.2",
    "electron-builder": "^25.1.8",
    "typescript": "^5.6.3",
    "vite": "^5.4.9",
    "vite-plugin-electron": "^0.28.8",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vite-plugin-node-polyfills": "^0.26.0"
  }
}
